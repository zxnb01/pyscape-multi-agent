# PyScape Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration (Required)
# Get from: https://supabase.com/dashboard
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# GNews API (Optional - for AI news dashboard)
# Get from: https://gnewsapi.com
REACT_APP_GNEWS_API_KEY=your-gnews-api-key-here

# RapidAPI Key (Required for code execution in duels)
# Get from: https://rapidapi.com/judge0-official/api/judge0-ce/
REACT_APP_RAPIDAPI_KEY=your-rapidapi-key-here

# Backend WebSocket Server (for development)
# Update if running backend on different host/port
REACT_APP_WEBSOCKET_URL=ws://localhost:8080

# Optional: Debug/Development Settings
REACT_APP_DEBUG=false
REACT_APP_ENV=development
